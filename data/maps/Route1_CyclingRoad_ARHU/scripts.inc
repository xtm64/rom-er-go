	end

Route1_CyclingRoad_ARHU_Text_Directions::
	.string "SOUTH: EARNEST TOWNSHIP\n"
	.string "NORTH: ROUTE 1\p"
	.string "WEST: EARNEST STATE CAMPUS$"
